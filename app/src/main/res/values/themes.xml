<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- AppCompat parent is required for AppCompatDelegate per-app locales on API < 33. -->
    <style name="Theme.Feather" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- The paper color, so there is no white flash before the first frame. -->
        <item name="android:windowBackground">@color/nest_paper</item>
    </style>

    <!-- For the snooze dialog: the activity itself is invisible, only the dialog shows. -->
    <style name="Theme.Feather.Translucent" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- The launch screen (Android 12 splash screen, backported by the AndroidX library). -->
    <style name="Theme.Feather.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_sky</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_bird</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.Feather</item>
    </style>
</resources>

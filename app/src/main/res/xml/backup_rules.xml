<?xml version="1.0" encoding="utf-8"?>
<!--
    What Auto Backup may copy on Android 11 and older (see data_extraction_rules.xml for the
    newer rules): the task database and the settings file only.
-->
<full-backup-content>
    <include domain="database" path="feather.db" />
    <include domain="database" path="feather.db-wal" />
    <include domain="database" path="feather.db-shm" />
    <include domain="file" path="datastore/" />
</full-backup-content>

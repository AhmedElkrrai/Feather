<?xml version="1.0" encoding="utf-8"?>
<!--
    What the operating system may copy when it backs up this app (Google's Auto Backup on
    Android 12+) or moves it to a new phone. Feather itself never uses the network; this is a
    system feature the user controls in the phone's own settings. Only the task database and
    the settings file are included; WorkManager's job database and caches are not.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="feather.db" />
        <include domain="database" path="feather.db-wal" />
        <include domain="database" path="feather.db-shm" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="feather.db" />
        <include domain="database" path="feather.db-wal" />
        <include domain="database" path="feather.db-shm" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
